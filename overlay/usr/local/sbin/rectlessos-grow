#!/bin/bash
# Растягивает раздел user (метка home-rw) на всё свободное место флешки.
# Запускается через 2,5 минуты после старта (когда вход в рабочий стол уже сделан), с низким
# приоритетом диска, чтобы не мешать входу. Безопасно запускать при каждой загрузке.
sleep "${GROW_DELAY:-150}"
dev="$(blkid -L home-rw 2>/dev/null)" || exit 0
base="$(basename "$dev")"
disk="/dev/$(lsblk -no PKNAME "$dev" | head -1)"
num="$(cat "/sys/class/block/$base/partition" 2>/dev/null)" || exit 0
[ -b "$disk" ] && [ -n "$num" ] || exit 0
growpart "$disk" "$num" >/dev/null 2>&1 || true   # код 1 = менять нечего
resize2fs "$dev" >/dev/null 2>&1 || true
exit 0
